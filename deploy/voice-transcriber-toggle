#!/bin/bash
# Voice Transcriber toggle shortcut wrapper
# Sends "toggle" command to the running tray daemon via its Unix socket
# Environment is fully isolated to prevent NumPy/gi collisions with other venvs
export PYTHONPATH=
export PYTHONNOUSERSITE=1
exec "$(dirname "$0")/../.venv/bin/python" "$(dirname "$0")/../tray.py" toggle